Avalie = $(Process)+10
Jobid = $INT(Avalie)
Universe     = Vanilla
Getenv       = True
Executable   = /afs/cern.ch/user/y/ymaruya/private/AHCAL-simulation/bin/SimCalModule_run4_on
Arguments    = /afs/cern.ch/user/y/ymaruya/private/AHCAL-simulation/mac/run_on_SciW_$(Jobid).mac $(Jobid) 
+JobFlavour = "testmatch"

# comment out the followings if you don't need to save STDOUT/STDERR/CondorLog
Output = out/off_on_SciW_EPOSLHC_$(Jobid).stdout
Error  = err/off_on_SciW_EPOSLHC_$(Jobid).stderr
Log    = log/off_on_SciW_EPOSLHC_$(Jobid).log

Queue 10