Avalie = $(Process)+10
Jobid = $INT(Avalie)
Universe     = Vanilla
Getenv       = True
Executable   = /afs/cern.ch/user/y/ymaruya/private/AHCAL-simulation/bin/SimCalModule_0mmW_muon_1000mmFe
Arguments    = /afs/cern.ch/user/y/ymaruya/private/AHCAL-simulation/mac/run_off_AHCAL0mmW_EPOSLHC_$(Jobid).mac $(Jobid) 
+JobFlavour = "testmatch"

# comment out the followings if you don't need to save STDOUT/STDERR/CondorLog
Output = out/off_AHCAL0mmW_muon_EPOSLHC_$(Jobid).stdout
Error  = err/off_AHCAL0mmW_muon_EPOSLHC_$(Jobid).stderr
Log    = log/off_AHCAL0mmW_muon_EPOSLHC_$(Jobid).log

Queue 10